# =============================================================================
# CallingAgent Module — Environment Variables
# =============================================================================
# Copy the variables below into your application's .env file and fill in the
# values for your environment.  All values shown here are examples.
# =============================================================================

# ── Twilio ───────────────────────────────────────────────────────────────────
# Required for voice calls, SMS, and WhatsApp.
# https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550001        # Your Twilio purchased phone number
TWILIO_WHATSAPP_FROM=+15005550001      # WhatsApp-enabled number (may differ)

# Set to "true" to bypass signature validation during local dev / tests.
# NEVER set to true in production.
CALLING_AGENT_SKIP_TWILIO_VALIDATION=false

# ── ElevenLabs ───────────────────────────────────────────────────────────────
# Required for AI voice synthesis and real-time voice streaming.
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # "Rachel" — replace as needed

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required for speech-to-text (STT) and outcome extraction.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o                    # Adjust to your subscription tier

# ── Realtime Bridge ──────────────────────────────────────────────────────────
# Controls whether the Twilio Media Stream real-time bridge is active.
# When false, incoming streams fall back to Gather/Say TwiML.
CALLING_AGENT_REALTIME_ENABLED=true

# ── Provider selection ───────────────────────────────────────────────────────
CALLING_AGENT_TELEPHONY_PROVIDER=twilio
CALLING_AGENT_TTS_PROVIDER=elevenlabs
CALLING_AGENT_STT_PROVIDER=openai
CALLING_AGENT_REALTIME_PROVIDER=elevenlabs

# ── Queue / Worker ───────────────────────────────────────────────────────────
# CallingAgent dispatches jobs to the queue for call summarisation and
# missed-call recovery. Use a dedicated queue in production.
CALLING_AGENT_QUEUE=calling-agent      # Queue name (default: "calling-agent")
# QUEUE_CONNECTION=redis               # Recommended: redis or sqs

# ── Calendar Federation (optional) ───────────────────────────────────────────
# CALLING_AGENT_CALENDAR_PROVIDER=google   # google | outlook | caldav
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=

# ── Feature flags ────────────────────────────────────────────────────────────
# All default to true — set to false to disable individual features.
# CALLING_AGENT_FEATURE_VOICE=true
# CALLING_AGENT_FEATURE_SMS=true
# CALLING_AGENT_FEATURE_WHATSAPP=true
# CALLING_AGENT_FEATURE_RECORDING=true
# CALLING_AGENT_FEATURE_VOICEMAIL=true
# CALLING_AGENT_FEATURE_BILLING=true
# CALLING_AGENT_FEATURE_CALLER_MEMORY=true
# CALLING_AGENT_FEATURE_MISSED_CALL_RECOVERY=true

# =============================================================================
# Twilio Webhook Setup
# =============================================================================
# In the Twilio Console, set the following webhook URLs on your phone number:
#
#   Voice / A Call Comes In (POST):
#     https://your-domain.com/calling-agent/webhooks/twilio/voice/incoming
#
#   Voice / Call Status Changes (POST):
#     https://your-domain.com/calling-agent/webhooks/twilio/voice/status
#
#   Messaging / A Message Comes In (POST):
#     https://your-domain.com/calling-agent/webhooks/twilio/message/incoming
#
# The Twilio signature middleware validates each request automatically.
# For local testing: use ngrok (https://ngrok.com) and set APP_URL accordingly.
#   ngrok http 8000
#   APP_URL=https://xxxx.ngrok.io

# =============================================================================
# ElevenLabs Agent Setup
# =============================================================================
# 1. Go to https://elevenlabs.io/app/conversational-ai
# 2. Create a new agent.
# 3. Copy the Agent ID into ELEVENLABS_AGENT_ID in calling_agents.settings:
#      { "elevenlabs_agent_id": "your-agent-id", "elevenlabs_voice_id": "..." }
# 4. For real-time streaming, enable "Realtime Bridge" in the Builder UI.

# =============================================================================
# Real-time Bridge (Twilio Media Streams + ElevenLabs)
# =============================================================================
# 1. Enable Media Streams on your Twilio phone number.
# 2. Set the Media Streams URL to:
#     https://your-domain.com/calling-agent/realtime/twilio
# 3. Set CALLING_AGENT_REALTIME_ENABLED=true.
# 4. The bridge auto-falls back to Gather/Say if the realtime provider is
#    unavailable or the feature is disabled.

# =============================================================================
# Supervisor / Systemd Worker Examples
# =============================================================================
# Supervisor (recommended for production):
#
# [program:calling-agent-worker]
# command=php /var/www/artisan queue:work redis --queue=calling-agent --sleep=3 --tries=3 --max-time=3600
# directory=/var/www
# autostart=true
# autorestart=true
# numprocs=2
# user=www-data
# stdout_logfile=/var/log/supervisor/calling-agent-worker.log
#
# Systemd:
#
# [Unit]
# Description=CallingAgent Queue Worker
# After=network.target
#
# [Service]
# User=www-data
# WorkingDirectory=/var/www
# ExecStart=/usr/bin/php artisan queue:work redis --queue=calling-agent --sleep=3 --tries=3
# Restart=on-failure
#
# [Install]
# WantedBy=multi-user.target

# =============================================================================
# Troubleshooting
# =============================================================================
# • "Twilio SDK not installed" — run: composer require twilio/sdk
# • "Twilio credentials not configured" — set TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN
# • 403 on webhooks — check CALLING_AGENT_SKIP_TWILIO_VALIDATION=false and
#   ensure APP_URL matches the URL Twilio is posting to exactly.
# • Calls not persisting — ensure migrations are run: php artisan migrate
# • Queue jobs not running — check queue worker is running for "calling-agent" queue
# • Builder UI not loading — ensure vendor assets are published:
#     php artisan vendor:publish --tag=calling-agent-assets
