{
  "schema_version": "1.0",
  "name": "create_escalation",
  "description": "Create an escalation ticket when the booking agent cannot resolve a query",
  "parameters": {
    "type": "object",
    "properties": {
      "reason": {"type": "string", "enum": ["complaint", "complex_request", "human_requested", "technical_issue", "payment_dispute", "policy_exception", "other"]},
      "urgency": {"type": "string", "enum": ["low", "normal", "high", "critical"]},
      "customer_name": {"type": "string"},
      "contact_number": {"type": "string"},
      "summary": {"type": "string", "description": "Brief summary of the issue"},
      "session_id": {"type": "string"},
      "conversation_context": {"type": "string"}
    },
    "required": ["reason", "summary"]
  },
  "returns": {
    "type": "object",
    "properties": {
      "ticket_id": {"type": "string"},
      "status": {"type": "string"},
      "estimated_response_time": {"type": "string"},
      "message_to_customer": {"type": "string"}
    }
  }
}
