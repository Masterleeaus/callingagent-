{
  "module": "TitanChatbot",
  "manifest": "ai",
  "version": "2.1.0",
  "enabled": true,
  "base_class": "Modules\\TitanChatbot\\AI\\Core\\TitanAgent",
  "agents": [
    "Modules\\TitanChatbot\\AI\\Agents\\ConversationAgent",
    "Modules\\TitanChatbot\\AI\\Agents\\BookingAgent",
    "Modules\\TitanChatbot\\AI\\Agents\\SupportAgent",
    "Modules\\TitanChatbot\\AI\\Agents\\VoiceAgent",
    "Modules\\TitanChatbot\\AI\\Agents\\ReceptionistAgent",
    "Modules\\TitanChatbot\\AI\\Agents\\CleaningBusinessAgent"
  ],
  "pipelines": [
    "Modules\\TitanChatbot\\AI\\Pipelines\\RagPipeline",
    "Modules\\TitanChatbot\\AI\\Pipelines\\RagAnswerPipeline",
    "Modules\\TitanChatbot\\AI\\Pipelines\\VoiceConversationPipeline"
  ],
  "tools": [
    "Modules\\TitanChatbot\\AI\\Tools\\EmbeddingResolver",
    "Modules\\TitanChatbot\\AI\\Tools\\QuoteEstimatorTool",
    "Modules\\TitanChatbot\\AI\\Tools\\SchemaGenerator",
    "Modules\\TitanChatbot\\AI\\Tools\\ToolRegistry"
  ],
  "tool_attributes": [
