    "Modules\\TitanChatbot\\AI\\DataModels\\QuoteRequestModel",
    "Modules\\TitanChatbot\\AI\\DataModels\\TrainingResultModel",
    "Modules\\TitanChatbot\\AI\\DataModels\\VoiceResponseModel"
